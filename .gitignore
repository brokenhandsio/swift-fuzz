.build/
.swiftpm/

# A library should not pin its dependencies for consumers, and this package's
# only dependency (swift-docc-plugin) exists solely when SWIFT_FUZZ_DOCC=1 — so
# the file appears and disappears depending on whether docs were last built.
/Package.resolved

# The examples intentionally rediscover a planted bug. Consumers can ignore
# working corpora too, but should preserve real discoveries and regression inputs.
Examples/**/Corpus/
Examples/**/Crashes/

# libFuzzer's per-worker logs, written to the working directory by --jobs.
Examples/**/fuzz-*.log

# Generated integration used by the container validation fixture.
Examples/OSSFuzzValidation/OSSFuzz/
